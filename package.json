{
  "name": "stackgraph",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @stackgraph/web dev",
    "build": "pnpm --filter @stackgraph/web build",
    "tokens": "node packages/design-system/scripts/generate-tokens.mjs",
    "contracts:generate": "node scripts/generate_contract_types.mjs",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- stackgraph-foundation/contracts/v1/openapi.json packages/shared/src/contracts/openapi.generated.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:css": "stylelint \"{apps,packages}/**/*.css\"",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "stylelint": "^16.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
