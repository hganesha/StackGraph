    "card":    { "$value": "10px",  "$type": "dimension" },
    "pill":    { "$value": "999px", "$type": "dimension" }
  },
  "border": {
    "hairline": { "$value": "1px", "$type": "dimension" },
    "connector-confirmed": { "$value": "2px solid", "$type": "border" },
    "connector-unconfirmed": { "$value": "1.5px dashed", "$type": "border" }
  },
  "elevation": {
    "flat":   { "$value": "none", "$type": "shadow" },
    "raised": { "$value": { "x": "0", "y": "2px", "blur": "8px", "spread": "0", "color": "#00000014" }, "$type": "shadow", "$description": "Only two elevation levels exist in Strata — flat and raised. Used for evidence drawer, modals, and the recommendation card only." }
  },
  "motion": {
    "hover":    { "$value": "150ms ease-out", "$type": "transition" },
    "panel":    { "$value": "200ms ease-out", "$type": "transition" },
    "bridge-pulse": { "$value": "1800ms ease-in-out infinite", "$type": "transition", "$description": "Reserved for the active selection at HIGH confidence (>=0.85) only. Disabled under prefers-reduced-motion." }
  },
  "confidence": {
    "high":   { "threshold": 0.85, "label": "HIGH",   "indicator": "3-bar", "color": "text.primary" },
    "medium": { "threshold": 0.60, "label": "MEDIUM", "indicator": "2-bar", "color": "text.primary" },
    "low":    { "threshold": 0.0,  "label": "LOW",    "indicator": "1-bar", "color": "signal.danger.500" }
  }
