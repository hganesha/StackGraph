    "scale": {
      "display": { "$value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": "500" }, "$type": "typography", "$description": "Hero metrics only — entropy score, viability delta" },
      "h1":      { "$value": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": "500" }, "$type": "typography" },
