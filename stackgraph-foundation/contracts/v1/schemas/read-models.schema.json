{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgraph.dev/contracts/v1/schemas/read-models.schema.json",
  "title": "StackGraph UI read models v1",
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["fact_id", "label"],
      "properties": {
        "fact_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "label": {"type": "string", "minLength": 1},
        "href": {"type": "string", "format": "uri-reference"}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["value", "confidence", "confidence_label", "method_version"],
      "properties": {
        "value": {"type": "number"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "method_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rankedItem": {
      "type": "object",
      "required": ["id", "kind", "name", "domain", "priority", "freshness"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "domain": {"$ref": "common.schema.json#/$defs/namespace"},
        "priority": {"$ref": "#/$defs/score"},
        "viability": {"$ref": "#/$defs/score"},
        "summary": {"type": "string"},
        "dependency_tier": {"type": "integer", "minimum": 1, "maximum": 2},
        "freshness": {"$ref": "common.schema.json#/$defs/freshness"},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "estateSummary": {
      "type": "object",
      "required": ["contract_version", "as_of", "counts", "distributions", "ranked_items", "coverage"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "as_of": {"$ref": "common.schema.json#/$defs/timestamp"},
        "counts": {
          "type": "object",
          "required": ["applications", "repositories", "services", "technologies"],
          "properties": {
            "applications": {"type": "integer", "minimum": 0},
            "repositories": {"type": "integer", "minimum": 0},
            "services": {"type": "integer", "minimum": 0},
            "technologies": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "distributions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "ranked_items": {"type": "array", "items": {"$ref": "#/$defs/rankedItem"}},
        "coverage": {
          "type": "object",
          "required": ["repositories_total", "repositories_scanned", "facts_with_evidence_ratio"],
          "properties": {
            "repositories_total": {"type": "integer", "minimum": 0},
            "repositories_scanned": {"type": "integer", "minimum": 0},
            "facts_with_evidence_ratio": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "page_info": {"$ref": "common.schema.json#/$defs/pageInfo"}
      },
      "additionalProperties": false
    },
    "entitySummary": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "canonical_key": {"type": "string"},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "assessmentSummary": {
      "type": "object",
      "required": ["id", "dimension", "confidence", "confidence_label", "method_version", "citations"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "dimension": {"type": "string", "minLength": 1},
        "score": {"type": "number"},
        "categorical_value": {"type": "string"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "method_version": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "oneOf": [
        {"required": ["score"], "not": {"required": ["categorical_value"]}},
        {"required": ["categorical_value"], "not": {"required": ["score"]}}
      ],
      "additionalProperties": false
    },
    "recommendationSummary": {
      "type": "object",
      "required": ["id", "action", "title", "rationale", "confidence", "confidence_label", "status", "citations"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "action": {"enum": ["RETAIN", "UPGRADE", "REMOVE", "REPLACE", "CONSOLIDATE", "REFACTOR", "REBUILD", "REPLATFORM", "RETIRE", "INVESTIGATE"]},
        "title": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "status": {"enum": ["PROPOSED", "ACCEPTED", "REJECTED", "PLANNED", "IN_PROGRESS", "COMPLETED", "DISMISSED"]},
        "estimated_effort": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
        "counter_signals": {"type": "array", "items": {"type": "string"}},
        "target": {"$ref": "#/$defs/entitySummary"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "taxonomySummary": {
      "type": "object",
      "required": ["key", "name"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "applicationTechnologyUsage": {
      "type": "object",
      "required": ["technology", "classification", "confidence", "confidence_label", "citations"],
      "properties": {
        "technology": {"$ref": "#/$defs/entitySummary"},
        "category": {"$ref": "#/$defs/taxonomySummary"},
        "classification": {"enum": ["CURATED", "CATALOG_MATCH", "UNCLASSIFIED"]},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "applicationTechnologyFunction": {
      "type": "object",
      "required": ["function", "technologies"],
      "properties": {
        "function": {"$ref": "#/$defs/taxonomySummary"},
        "technologies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationTechnologyUsage"}}
      },
      "additionalProperties": false
    },
    "applicationTechnologyGroup": {
      "type": "object",
      "required": ["domain", "functions"],
      "properties": {
        "domain": {"$ref": "#/$defs/taxonomySummary"},
        "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationTechnologyFunction"}}
      },
      "additionalProperties": false
    },
    "applicationDependencyNode": {
      "type": "object",
      "required": ["technology", "depth", "direct", "relationship", "confidence", "confidence_label", "citations"],
      "properties": {
        "technology": {"$ref": "#/$defs/entitySummary"},
        "parent_technology_id": {"type": "string", "format": "uuid"},
        "depth": {"type": "integer", "minimum": 1},
        "direct": {"type": "boolean"},
        "relationship": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "requirement": {"type": "string"},
        "dependency_relation": {"type": "string"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "applicationComponentDependencyHierarchy": {
      "type": "object",
      "required": ["component_path", "dependencies", "truncated"],
      "properties": {
        "component_path": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationDependencyNode"}},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "applicationRepositoryDependencyHierarchy": {
      "type": "object",
      "required": ["repository", "components"],
      "properties": {
        "repository": {"$ref": "#/$defs/entitySummary"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationComponentDependencyHierarchy"}}
      },
      "additionalProperties": false
    },
    "technologyEstateHierarchyNode": {
      "type": "object",
      "required": ["technology", "depth", "direct", "relationship", "confidence", "confidence_label", "dependent_applications", "citations"],
      "properties": {
        "technology": {"$ref": "#/$defs/entitySummary"},
        "parent_technology_id": {"type": "string", "format": "uuid"},
        "depth": {"type": "integer", "minimum": 1},
        "direct": {"type": "boolean"},
        "relationship": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "dependent_applications": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "catalog_profile": {"$ref": "#/$defs/technologyCatalogProfile"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "technologyHierarchy": {
      "type": "object",
      "required": ["contract_version", "as_of", "nodes", "truncated"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "as_of": {"type": "string", "format": "date-time"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/technologyEstateHierarchyNode"}},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "applicationDetail": {
      "type": "object",
      "required": ["contract_version", "application", "business_context", "repositories", "technologies", "technology_groups", "deployments", "assessments", "recommendations", "freshness"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "application": {"$ref": "#/$defs/entitySummary"},
        "business_context": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "repositories": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "technologies": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "technology_groups": {"type": "array", "items": {"$ref": "#/$defs/applicationTechnologyGroup"}},
        "dependency_hierarchies": {"type": "array", "items": {"$ref": "#/$defs/applicationRepositoryDependencyHierarchy"}},
        "deployments": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessmentSummary"}},
        "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendationSummary"}},
        "freshness": {"$ref": "common.schema.json#/$defs/freshness"}
      },
      "additionalProperties": false
    },
    "repositoryProfile": {
      "type": "object",
      "required": ["descriptions", "languages", "components", "key_files", "operational_signals", "limitations", "source_revision", "confidence", "confidence_label", "citations"],
      "properties": {
        "purpose": {"type": "string"},
        "purpose_source": {"type": "string"},
        "descriptions": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "items": {"type": "string"}},
        "key_files": {"type": "array", "items": {"type": "string"}},
        "operational_signals": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "source_revision": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_label": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "repositoryDetail": {
      "type": "object",
      "required": ["contract_version", "repository", "applications", "technologies", "deployments", "freshness"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "repository": {"$ref": "#/$defs/entitySummary"},
        "profile": {"$ref": "#/$defs/repositoryProfile"},
        "applications": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "technologies": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "deployments": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "freshness": {"$ref": "common.schema.json#/$defs/freshness"}
      },
      "additionalProperties": false
    },
    "technologyDetail": {
      "type": "object",
      "required": ["contract_version", "technology", "internal_usage", "packages", "projects", "assessments", "recommendations", "freshness"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "technology": {"$ref": "#/$defs/entitySummary"},
        "internal_usage": {
          "type": "object",
          "required": ["repository_count", "application_count"],
          "properties": {
            "repository_count": {"type": "integer", "minimum": 0},
            "application_count": {"type": "integer", "minimum": 0},
            "repositories": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}}
          },
          "additionalProperties": false
        },
        "packages": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "projects": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "catalog_profile": {"$ref": "#/$defs/technologyCatalogProfile"},
        "registry_sources": {"type": "array", "items": {"$ref": "#/$defs/packageSource"}},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "migration_patterns": {"type": "array", "items": {"$ref": "#/$defs/entitySummary"}},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessmentSummary"}},
        "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendationSummary"}},
        "freshness": {"$ref": "common.schema.json#/$defs/freshness"}
      },
      "additionalProperties": false
    },
    "technologyCatalogProfile": {
      "type": "object",
      "required": ["functions", "classification", "citations"],
      "properties": {
        "summary": {"type": ["string", "null"]},
        "package_name": {"type": ["string", "null"]},
        "ecosystem": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "homepage": {"type": ["string", "null"], "format": "uri"},
        "repository_url": {"type": ["string", "null"], "format": "uri"},
        "package_url": {"type": ["string", "null"], "format": "uri"},
        "latest_version": {"type": ["string", "null"]},
        "weekly_downloads": {"type": ["integer", "null"], "minimum": 0},
        "dependents": {"type": ["integer", "null"], "minimum": 0},
        "versions": {"type": ["integer", "null"], "minimum": 0},
        "installation_command": {"type": ["string", "null"]},
        "catalog_technology": {
          "oneOf": [{"$ref": "#/$defs/entitySummary"}, {"type": "null"}]
        },
        "domain": {
          "oneOf": [{"$ref": "#/$defs/taxonomySummary"}, {"type": "null"}]
        },
        "category": {
          "oneOf": [{"$ref": "#/$defs/taxonomySummary"}, {"type": "null"}]
        },
        "functions": {"type": "array", "items": {"$ref": "#/$defs/taxonomySummary"}},
        "classification": {"enum": ["CURATED", "CATALOG_MATCH", "UNCLASSIFIED"]},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      },
      "additionalProperties": false
    },
    "packageSource": {
      "type": "object",
      "required": ["registry_key", "origin", "visibility", "tenant_scoped", "freshness"],
      "properties": {
        "registry_key": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "format": "uri"},
        "visibility": {"enum": ["PUBLIC", "PRIVATE", "UNKNOWN"]},
        "tenant_scoped": {"type": "boolean"},
        "freshness": {"$ref": "common.schema.json#/$defs/freshness"}
      },
      "additionalProperties": false
    },
    "modernizationList": {
      "type": "object",
      "required": ["contract_version", "as_of", "opportunities", "page_info"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "as_of": {"$ref": "common.schema.json#/$defs/timestamp"},
        "opportunities": {"type": "array", "items": {"$ref": "#/$defs/rankedItem"}},
        "page_info": {"$ref": "common.schema.json#/$defs/pageInfo"}
      },
      "additionalProperties": false
    },
    "graphNode": {
      "type": "object",
      "required": ["id", "namespace", "type", "key", "label", "aggregate"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "namespace": {"$ref": "common.schema.json#/$defs/namespace"},
        "type": {"type": "string"},
        "key": {"type": "string"},
        "label": {"type": "string"},
        "aggregate": {"type": "boolean"},
        "member_count": {"type": "integer", "minimum": 1},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"}
      },
      "additionalProperties": false
    },
    "graphEdge": {
      "type": "object",
      "required": ["id", "source", "target", "predicate", "confidence", "assertion_class", "review_state", "citation_fact_ids"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "source": {"$ref": "common.schema.json#/$defs/uuid"},
        "target": {"$ref": "common.schema.json#/$defs/uuid"},
        "predicate": {"type": "string"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "assertion_class": {"$ref": "common.schema.json#/$defs/assertionClass"},
        "review_state": {"enum": ["CONFIRMED", "POSSIBLE", "REJECTED", "NOT_APPLICABLE"]},
        "citation_fact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/uuid"}}
      },
      "additionalProperties": false
    },
    "graphNeighborhood": {
      "type": "object",
      "required": ["contract_version", "center_id", "nodes", "edges", "truncated"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "center_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "nodes": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/graphNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}},
        "highlighted_path": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/uuid"}},
        "truncated": {"type": "boolean"},
        "truncation_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidenceDetail": {
      "type": "object",
      "required": ["contract_version", "fact_id", "assertion_class", "confidence", "predicate", "source_revision", "extractor", "evidence", "observed_at"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "fact_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "assertion_class": {"$ref": "common.schema.json#/$defs/assertionClass"},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "predicate": {"type": "string"},
        "source_revision": {"type": "string"},
        "extractor": {"$ref": "common.schema.json#/$defs/extractor"},
        "properties": {"type": "object"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "effective_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "closed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "askRequest": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "context_entity_ids": {"type": "array", "maxItems": 20, "items": {"$ref": "common.schema.json#/$defs/uuid"}}
      },
      "additionalProperties": false
    },
    "askResponse": {
      "type": "object",
      "required": ["contract_version", "text", "citations", "result_kind"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "text": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "result_kind": {"enum": ["ANSWER", "TABLE", "GRAPH", "UNSUPPORTED"]},
        "rows": {"type": "array", "items": {"type": "object"}},
        "graph_highlight": {"$ref": "#/$defs/graphNeighborhood"}
      },
      "additionalProperties": false
    },
    "identityReviewRequest": {
      "type": "object",
      "required": ["decision", "rationale", "expected_version"],
      "properties": {
        "decision": {"enum": ["CONFIRM", "REJECT"]},
        "rationale": {"type": "string", "minLength": 1},
        "expected_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "identityReviewResult": {
      "type": "object",
      "required": ["contract_version", "identity_assertion_id", "review_state", "version", "reviewed_at"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "identity_assertion_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "review_state": {"enum": ["CONFIRMED", "REJECTED"]},
        "version": {"type": "integer", "minimum": 2},
        "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "capabilityDefinition": {
      "type": "object",
      "required": ["key", "name", "description", "aliases"],
      "properties": {
        "key": {"type": "string", "minLength": 2},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parent_key": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "capabilityTaxonomy": {
      "type": "object",
      "required": ["contract_version", "key", "version", "name", "description", "content_hash", "capabilities"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "key": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityDefinition"}}
      },
      "additionalProperties": false
    },
    "capabilityInference": {
      "type": "object",
      "required": ["id", "subject", "capability", "source_revision", "assertion_class", "confidence", "confidence_band", "supporting_fact_ids", "counter_evidence_fact_ids", "taxonomy_key", "taxonomy_version", "analyzer", "policy_version", "rationale", "review_state", "version", "stale", "created_at"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "subject": {"$ref": "#/$defs/entitySummary"},
        "capability": {"$ref": "#/$defs/capabilityDefinition"},
        "source_revision": {"type": "string", "minLength": 1},
        "assertion_class": {"enum": ["CURATED", "INFERRED"]},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "confidence_band": {"$ref": "common.schema.json#/$defs/confidenceLabel"},
        "supporting_fact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/uuid"}},
