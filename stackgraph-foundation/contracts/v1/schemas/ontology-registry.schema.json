{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgraph.dev/contracts/v1/schemas/ontology-registry.schema.json",
  "title": "StackGraph ontology registry",
  "type": "object",
  "required": ["contract_version", "namespaces", "predicates"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "namespaces": {
      "type": "object",
      "required": ["BUSINESS", "ENTERPRISE", "TECHNOLOGY", "OSS", "DEPLOYMENT", "INTELLIGENCE"],
      "properties": {
        "BUSINESS": {"$ref": "#/$defs/entityTypes"},
        "ENTERPRISE": {"$ref": "#/$defs/entityTypes"},
        "TECHNOLOGY": {"$ref": "#/$defs/entityTypes"},
        "OSS": {"$ref": "#/$defs/entityTypes"},
        "DEPLOYMENT": {"$ref": "#/$defs/entityTypes"},
        "INTELLIGENCE": {"$ref": "#/$defs/entityTypes"}
      },
      "additionalProperties": false
    },
    "predicates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["object_kind"],
        "properties": {
          "object_kind": {"enum": ["ENTITY", "VALUE", "EITHER"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
