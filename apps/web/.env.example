# StackGraph web — environment. Copy to .env.local to override.
#
# Data source: "fixtures" (default) renders from contracts/v1 fixtures with no backend;
# "live" calls the real read API. The swap is entirely inside @stackgraph/shared's client —
# no component changes (the Lane C promise).
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Base URL of the live read API (used only when DATA_SOURCE=live). Read models mount under /api/v1.
# The API must allow this web origin via CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
