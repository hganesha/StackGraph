STACKGRAPH_DB_NAME=stackgraph
STACKGRAPH_DB_ADMIN_USER=stackgraph_admin
STACKGRAPH_DB_ADMIN_PASSWORD=replace-with-random-database-admin-password
STACKGRAPH_DB_APP_USER=stackgraph_app
STACKGRAPH_DB_APP_PASSWORD=replace-with-random-database-app-password
STACKGRAPH_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
STACKGRAPH_AUTH_SESSION_KEYS_JSON={"2026-08":"replace-with-at-least-32-random-characters"}
