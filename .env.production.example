STACKGRAPH_OIDC_ISSUER=https://identity.example.com
STACKGRAPH_OIDC_CLIENT_ID=replace-with-oidc-client-id
STACKGRAPH_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
STACKGRAPH_OIDC_TENANT_CLAIM=stackgraph_tenant_id
STACKGRAPH_OIDC_GROUPS_CLAIM=groups
STACKGRAPH_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
STACKGRAPH_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
STACKGRAPH_SENTRY_DSN=
STACKGRAPH_ALERT_WEBHOOK_URL=https://alerts.example.com/stackgraph
STACKGRAPH_GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
STACKGRAPH_OBJECT_STORE_ACCESS_KEY=replace-with-random-object-store-access-key
STACKGRAPH_OBJECT_STORE_SECRET_KEY=replace-with-random-object-store-secret-key
