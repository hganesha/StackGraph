{
  "contract_version": "1.0.0",
  "key": "architecture.stackgraph.reference",
  "version": "1.0.0",
  "name": "StackGraph reference architecture",
  "description": "Canonical six-domain technical reference model covering experience, application, integration, data, platform, and delivery concerns.",
  "taxonomy_key": "stackgraph.technical-taxonomy",
  "taxonomy_version": "2.0.0",
  "taxonomy_content_hash": "sha256:78b266adb22c7b5715e436a6e5942564453d783cf1e6b4474c0fcf988e0a63e6",
  "content_hash": "sha256:283168e57dc065da5a1f585e761301c80825f30b23c70452eb61f16a4282f621",
  "domains": [
    {
      "key": "experience",
      "label": "Experience & Channels",
      "question": "How do humans and external clients interact with the system?",
      "order": 0
    },
    {
      "key": "application",
      "label": "Application & Services",
      "question": "Where do application behaviour and service responsibilities execute?",
      "order": 1
    },
    {
      "key": "integration",
      "label": "Integration & Messaging",
      "question": "How do requests, events, and workflows cross boundaries?",
      "order": 2
    },
    {
      "key": "data",
      "label": "Data & Information",
      "question": "How is information stored, retrieved, moved, and processed?",
      "order": 3
    },
    {
      "key": "platform",
      "label": "Platform & Runtime",
      "question": "On what runtime, compute, network, and managed platform does the system operate?",
      "order": 4
    },
    {
      "key": "delivery",
      "label": "Delivery & Operations",
      "question": "How is software built, tested, configured, released, observed, and operated?",
      "order": 5
    }
  ],
  "aspects": [
    {
      "key": "security-privacy",
      "label": "Security & privacy",
      "definition": "Controls protecting confidentiality, integrity, and privacy of the system and its data.",
      "order": 0
    },
    {
      "key": "identity-access",
      "label": "Identity & access",
      "definition": "Authentication, authorization, and credential distribution across the estate.",
      "order": 1
    },
    {
      "key": "governance-compliance",
      "label": "Governance & compliance",
      "definition": "Policy, standards, audit, and regulatory obligations applied to architecture decisions.",
      "order": 2
    },
    {
      "key": "reliability-resilience",
      "label": "Reliability & resilience",
      "definition": "Failure containment, recovery, and continuity of service.",
      "order": 3
    },
    {
      "key": "observability",
      "label": "Observability",
      "definition": "The ability to explain system behaviour from emitted signals.",
      "order": 4
    },
    {
      "key": "developer-experience",
      "label": "Developer experience",
      "definition": "Feedback speed and friction for the teams changing this system.",
      "order": 5
    },
    {
      "key": "cost-efficiency",
      "label": "Cost & efficiency",
      "definition": "Resource consumption and unit economics of the architecture.",
      "order": 6
    },
    {
      "key": "data-governance",
      "label": "Data governance",
      "definition": "Ownership, lineage, classification, and lifecycle of information assets.",
      "order": 7
    }
  ],
