STACKGRAPH_API_PORT=8080
STACKGRAPH_WEB_PORT=3000
# Browser-visible API URL baked into the standalone web image.
STACKGRAPH_PUBLIC_API_BASE_URL=http://localhost:8080
STACKGRAPH_WEB_AUTH_REQUIRED=false
STACKGRAPH_DB_PORT=5432
STACKGRAPH_DB_NAME=stackgraph
STACKGRAPH_DB_ADMIN_USER=stackgraph_admin
STACKGRAPH_DB_ADMIN_PASSWORD=stackgraph_admin
STACKGRAPH_DB_APP_USER=stackgraph_app
STACKGRAPH_DB_APP_PASSWORD=stackgraph_app
STACKGRAPH_DB_POOL_MIN_SIZE=1
STACKGRAPH_DB_POOL_MAX_SIZE=5
STACKGRAPH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STACKGRAPH_AUTH_MODE=development
STACKGRAPH_DEVELOPMENT_ACTOR_KEY=local-user
STACKGRAPH_GRAPH_READ_MODE=auto
STACKGRAPH_GRAPH_DISCOVERY_LIMIT=5000
# Use signed_session outside local development and set a random secret of at least 32 characters.
# STACKGRAPH_AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# For rotation, prefer: STACKGRAPH_AUTH_SESSION_KEYS_JSON={"primary":"replace-with-at-least-32-random-characters"}
# STACKGRAPH_AUTH_SESSION_ACTIVE_KID=primary
# STACKGRAPH_AUTH_SESSION_AUDIENCE=stackgraph-api
# OIDC requires issuer/client credentials and an exact callback URI.
# STACKGRAPH_OIDC_ISSUER=https://identity.example.com
# STACKGRAPH_OIDC_CLIENT_ID=
# STACKGRAPH_OIDC_CLIENT_SECRET=
# STACKGRAPH_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
# STACKGRAPH_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000000
# Optional runtime-only token for the npm registry acquisition tool.
# STACKGRAPH_NPM_REGISTRY_TOKEN=

# Local GitHub App lifecycle tools. Values remain runtime-only and are never persisted.
STACKGRAPH_GITHUB_WEBHOOK_PORT=8090
# Configure these to process GitHub App installations registered in Admin → Connections.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/stackgraph-github-app-private-key.pem
# GITHUB_INSTALLATION_TOKEN=
# Used by the Admin repository picker and direct-repository discovery worker.
# GITHUB_TOKEN=
# Local Docker uses a development-only default; always set a random value for a real GitHub webhook.
# GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
STACKGRAPH_GITHUB_API_URL=https://api.github.com
STACKGRAPH_GITHUB_ALLOW_INSECURE_LOCALHOST=false
STACKGRAPH_PIPELINE_POLL_SECONDS=2
STACKGRAPH_INTELLIGENCE_BATCH_SIZE=10

# AI-backed Ask is opt-in. Configure one logical route and its provider credential.
STACKGRAPH_AI_ASK_ENABLED=false
STACKGRAPH_AI_ASK_ROUTE=default
STACKGRAPH_AI_ASK_FALLBACK_ENABLED=true
STACKGRAPH_AI_ASK_MAX_EVIDENCE_CHARS=50000
STACKGRAPH_REQUEST_BODY_MAX_BYTES=1048576
STACKGRAPH_RATE_LIMIT_REQUESTS_PER_MINUTE=300
STACKGRAPH_RATE_LIMIT_ASK_PER_MINUTE=20
# Required for the internal Prometheus scrape endpoint.
# STACKGRAPH_METRICS_BEARER_TOKEN=
# STACKGRAPH_SENTRY_DSN=
# Required outside development/test. Encrypts tenant provider credentials at rest.
STACKGRAPH_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# STACKGRAPH_AI_ROUTES_JSON={"default":{"provider":"openrouter","model":"your/model-id"}}
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
